# === Database ===
DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@localhost:5432/agenthub
# Pytest 默认会覆盖为内存 SQLite（避免 shell 里已 export 的 file DB 与 uvicorn 抢锁）。
# 若要用真实库跑 backend pytest，在命令前导出：AGENTHUB_TEST_DATABASE_URL="$DATABASE_URL"
# AGENTHUB_TEST_DATABASE_URL=
# `make test-relay` 会设 AGENTHUB_TEST_MINIMAL_LIFESPAN=1，跳过 agent 种子与技能目录扫描以加速。
# AGENTHUB_TEST_MINIMAL_LIFESPAN=

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Security ===
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
# OS environment overrides this file. `make reset-admin` loads backend/.env then ../.env like `make dev`.
ADMIN_PASSWORD=changeme

# === CORS ===
# Use single quotes so `source .env` in bash does not strip the JSON string quotes.
CORS_ORIGINS='["http://localhost:5200","http://127.0.0.1:5200"]'

# === LLM Provider Keys (配置哪个用哪个) ===
OPENAI_API_KEY=

# OpenAI Images（design 阶段 generate_image_asset；可选）
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_TIMEOUT_SECONDS=120

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=

# === Default LLM (兜底) ===
# 公司内网 OpenAI 兼容网关：把网关主机加入 LLM_ALLOWED_HOSTS，否则 SSRF 校验会拒绝私网地址。
# LLM_API_URL=http://192.168.130.230:1234/v1/chat/completions
# LLM_API_KEY=ddd
# LLM_MODEL=google/gemma-4-26b-a4b
# LLM_ALLOWED_HOSTS=192.168.130.230,localhost,127.0.0.1
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 本地 / 内网 OpenAI-compat（Ollama、vLLM、公司聚合网关）：逗号分隔 hostname
# LLM_ALLOWED_HOSTS=localhost,127.0.0.1

# 可选：仅提供 ANTHROPIC_* 时，config 会映射到 LLM_*（仍会走 OpenAI-compat JSON）。
# 内网友情提示：同样需要 LLM_ALLOWED_HOSTS 放行网关主机。
# ANTHROPIC_BASE_URL=http://192.168.130.230:1234
# ANTHROPIC_AUTH_TOKEN=ddd
# ANTHROPIC_MODEL=google/gemma-4-26b-a4b
# ANTHROPIC_DEFAULT_HAIKU_MODEL=google/gemma-4-26b-a4b
# ANTHROPIC_DEFAULT_SONNET_MODEL=google/gemma-4-26b-a4b
# ANTHROPIC_DEFAULT_OPUS_MODEL=google/gemma-4-26b-a4b

# === Pipeline ===
PIPELINE_API_KEY=

# === OpenAI-compatible relay (/v1/*，客户 ahrelay_* 密钥，扣 workspace 余额) ===
# RELAY_MARKUP_MULTIPLIER=1.0
# RELAY_MIN_BALANCE_USD=0
# RELAY_FALLBACK_USD_PER_1K_TOTAL=0.00015
# 每个 ahrelay_ 密钥在 /v1/* 上的每分钟上限；不设则与 RATE_LIMIT_PER_MINUTE 相同
# RELAY_RATE_LIMIT_PER_MINUTE=

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60

# === Model Cache ===
MODEL_CACHE_TTL_SECONDS=600

# === LLM circuit breaker (consecutive timeouts / 5xx / quota → skip model briefly) ===
# LLM_CIRCUIT_BREAKER_ENABLED=1
# LLM_CIRCUIT_FAILURE_THRESHOLD=3
# LLM_CIRCUIT_OPEN_SECONDS=120
# LLM_CIRCUIT_STREAK_TTL_SECONDS=300

# === Executor ===
# Comma-separated list of directories the executor is allowed to work in
EXECUTOR_ALLOWED_DIRS=

# === Project Binding (git clone allowlist) ===
# Comma-separated hostnames allowed for `repo_url`. SSRF / arbitrary-host clones rejected.
GIT_ALLOWED_HOSTS=github.com,gitee.com,gitlab.com,bitbucket.org,codeup.aliyun.com

# === Sandbox isolation ===
# When true AND `docker` CLI works, bash tool runs inside a fresh container with
# --network none --read-only --cap-drop ALL. Falls back to strict subprocess otherwise.
SANDBOX_USE_DOCKER=false
SANDBOX_DOCKER_IMAGE=agent-hub/sandbox:latest
SANDBOX_DOCKER_NETWORK=none
SANDBOX_DOCKER_MEMORY=1g
SANDBOX_DOCKER_CPUS=1
SANDBOX_DOCKER_TIMEOUT=1800
SANDBOX_STRICT_BASH=true

# === Long-task budgets ===
PHASE_TIMEOUT_SECONDS=1800
PHASE_MAX_TIMEOUT_SECONDS=7200

# === Browser tool (Playwright) ===
# Install: pip install playwright && playwright install chromium
BROWSER_ENABLED=true
BROWSER_MAX_PAGES=5
BROWSER_DEFAULT_TIMEOUT_MS=30000

# === Codebase index ===
CODEBASE_INDEX_MAX_FILES=5000
CODEBASE_INDEX_MAX_FILE_KB=200

# === Task artifact v2 + contract ===
ARTIFACT_STORE_V2=true
# Require catalogued v2 artifact types after each executing stage
ARTIFACT_CONTRACT_ENFORCE=true
# Treat advisory rules (min length / JSON shape / PRD heading groups) as stage failures — stricter QA
ARTIFACT_CONTRACT_RULES_STRICT=false

# === Plan/Act dual-mode (IM gateway) ===
# When true, after the clarifier accepts a requirement we generate a short
# execution plan and push it to the IM user, waiting for approval
# ("通过" / "approve" / "开干") before actually starting the pipeline.
# When false (default), the pipeline kicks off immediately.
GATEWAY_PLAN_MODE=false

# === Gateway: Feishu (Lark) ===
# 开放平台 → 自建应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 开放平台 → 事件订阅 → Verification Token
FEISHU_VERIFICATION_TOKEN=
# 开放平台 → 事件订阅 → Encrypt Key（启用加密策略后必填）
FEISHU_ENCRYPT_KEY=
# 兜底：自定义群机器人 webhook（IM API 不可用时降级使用）
FEISHU_GROUP_WEBHOOK=

# === Gateway: QQ (OneBot v11 bridge) ===
# OneBot 桥（NapCat / go-cqhttp / Lagrange）的 HTTP API base URL
QQ_BOT_ENDPOINT=http://127.0.0.1:5700
# OneBot access_token，用于入站校验和出站调用
QQ_BOT_ACCESS_TOKEN=

# === Deploy targets (按需配置) ===
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# === WeChat Mini Program (可选) ===
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
WECHAT_MP_PRIVATE_KEY_PATH=

# === Firecrawl — Web scraping ===
# Cloud mode: set FIRECRAWL_API_KEY (https://firecrawl.dev)
# Self-hosted: set FIRECRAWL_SELF_HOSTED_URL + docker compose up firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_SELF_HOSTED_URL=
# FIRECRAWL_TIMEOUT=120

# === GitHub MCP — Agent tools for GitHub (repos/issues/PRs/code) ===
# 需要: npx + @modelcontextprotocol/server-github
# 已通过 .mcp.json  + global ~/.claude/mcp.json 配置
GITHUB_PERSONAL_ACCESS_TOKEN=

# === Debug ===
# Local dev with default ADMIN_PASSWORD=changeme: set DEBUG=true (weak passwords are rejected when DEBUG=false).
DEBUG=false
